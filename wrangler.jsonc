{
  // Configuración de Cloudflare para el Planificador
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planificador",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Base creada en la primera publicación (Storage & databases → D1). Las tablas las crea el servidor.
      "database_name": "planificador-db",
      "database_id": "f9238130-a166-4b93-832d-4b733df4288c"
    }
  ],
  "observability": { "enabled": true }
}
